# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# WordPress sensitive files — never commit these
wp-config.php
*.log
debug.log

# Python bytecode — the skills' scripts are run directly, and a committed
.pyc goes stale against the .py beside it.
__pycache__/
*.pyc

# Node / build tools (if ever added)
node_modules/
npm-debug.log
yarn.lock
package-lock.json
dist/
build/

# Composer (if ever added)
vendor/
composer.lock

# Local dev
.env
.env.local
*.local

# Backups
*-backup.php
*-backup/
