# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# WordPress sensitive files — never commit these
wp-config.php
*.log
debug.log

# Python bytecode — the skills' scripts are run directly, and a committed
.pyc goes stale against the .py beside it.
__pycache__/
*.pyc

# Node / build tools (if ever added)
node_modules/
npm-debug.log
yarn.lock
package-lock.json
dist/
build/

# Composer (if ever added)
vendor/
composer.lock

# Local dev
.env
.env.local
*.local

# Backups
*-backup.php
*-backup/

# Client deliverables generated by the SEO skills — audits, strategies, drafts.
# They carry a real client's address, phone and commercial answers, and this
# repo is the theme plus the skills, not a document store. The skills write
# here; the finished document goes to the client and to their portal via
# save_client_artifact.
out/
